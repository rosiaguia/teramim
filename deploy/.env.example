# Variáveis que o app usa. Copie este arquivo para `.env` e preencha.
# IMPORTANTE: nunca publique o arquivo .env.

# Chave da IA (a mesma que você cola no painel). Sem ela, a IA fica em modo demo.
USER_LLM_API_KEY=
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# Link de checkout (Kiwify/Hotmart) — também pode configurar no painel.
CHECKOUT_URL=

# PIN de acesso ao painel da Rosi (4 a 8 números). Troque por um seu.
ADMIN_PIN=052123

# (Opcional) Chave de TTS da ElevenLabs, se quiser voz gerada por IA.
# USER_ELEVENLABS_API_KEY=
# USER_ELEVENLABS_VOICE_ID=
