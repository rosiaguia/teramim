# Copie este arquivo para .env e preencha com SUAS chaves (a Rosi aguia envia as dela).
# O servidor NUNCA expõe estes valores; eles vivem apenas no backend.

# ===== IA de conversa (OpenAI, DeepSeek ou qualquer provedor compatível) =====
# Peça sua chave de API no provedor escolhido.
USER_LLM_API_KEY=
# Para OpenAI: https://api.openai.com/v1
# Para DeepSeek: https://api.deepseek.com/v1
USER_LLM_BASE_URL=https://api.openai.com/v1
USER_LLM_MODEL=gpt-4o-mini

# ===== Clonagem de voz (ElevenLabs) =====
# 1) Crie a conta em elevenlabs.io
# 2) Vá em VoiceLab -> Instant Voice Cloning e envie os áudios da Rosi
# 3) Copie o Voice ID e cole aqui
USER_ELEVENLABS_API_KEY=
USER_ELEVENLABS_VOICE_ID=
# Modelo de voz: eleven_multilingual_v2 ou eleven_multilingual_v3
USER_ELEVENLABS_MODEL=eleven_multilingual_v2

# ===== Pagamento e assinatura recorrente (Kiwify) =====
# Token/segredo do webhook. Pegue em: Kiwify > Apps > Webhooks.
# Deixe vazio apenas em testes locais; em produção SEMPRE preencha.
KIWIFY_WEBHOOK_SECRET=
# Dias de acesso liberados a cada pagamento/renovação confirmada (padrão 30).
SUBSCRIPTION_DAYS=30

# ===== Servidor =====
PORT=3001
